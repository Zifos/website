---
import { Font } from "astro:assets";
import { PREVIEW } from "astro:env/server";
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import {
  defaultLocale,
  LOCALE_STORAGE_KEY,
  localeInfo,
  locales,
  routePath,
  toLocale,
} from "@/i18n";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  /** Force a color scheme for the whole page (browser chrome, overscroll); default follows the system. */
  scheme?: "dark" | "light";
}

const { title, description, image, noindex: noindexProp = false, scheme } = Astro.props;
const noindex = noindexProp || PREVIEW;
// Site-root-relative asset URLs must include the base path (e.g. /website/ on GitHub Pages).
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const locale = toLocale(Astro.currentLocale);
const path = routePath(Astro.url.pathname);
// Where the root-language redirect may send a visitor (see the inline script below).
const localeUrls = Object.fromEntries(locales.map((l) => [l, getRelativeLocaleUrl(l, path)]));

const siteName = "Zifos";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: Astro.site?.href,
};
---

<!doctype html>
<html lang={locale} data-scheme={scheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /*
        Default-locale (unprefixed) URLs follow the visitor's language: an explicit pick from the
        language switch wins, else the first of the browser's languages we serve. Runs before first
        paint so there's no flash. Prefixed URLs (/es/) are explicit and never redirect.
      */
      locale === defaultLocale && (
        <script
          is:inline
          define:vars={{ urls: localeUrls, current: locale, key: LOCALE_STORAGE_KEY }}
        >
          let target;
          try {
            target = localStorage.getItem(key);
          } catch {}
          if (!Object.hasOwn(urls, target)) {
            target = (navigator.languages ?? [navigator.language])
              .map((tag) => tag.split("-")[0].toLowerCase())
              .find((lang) => Object.hasOwn(urls, lang));
          }
          if (target && target !== current) {
            location.replace(urls[target] + location.search + location.hash);
          }
        </script>
      )
    }
    <title>{title}</title>

    <!-- Preload only the headline face (LCP); the rest load on first use. -->
    <Font cssVariable="--font-instrument-serif" preload={[{ style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-dm-sans" />
    <Font cssVariable="--font-ibm-plex-mono" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, path)} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, path)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    {
      scheme ? (
        <meta name="theme-color" content={scheme === "dark" ? "#0F0F10" : "#F5F1EA"} />
      ) : (
        <>
          <meta name="theme-color" content="#F5F1EA" media="(prefers-color-scheme: light)" />
          <meta name="theme-color" content="#0F0F10" media="(prefers-color-scheme: dark)" />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeInfo[locale].og} />
    {
      locales
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={localeInfo[l].og} />)
    }
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
